# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: multi-tenant-auth-rbac
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - In-memory SQLite tenant store with isolated namespaces.
#
# TIER 2 / TIER 3: PRODUCTION MULTI-TENANT POSTGRESQL
# - Supply PostgreSQL connection string with row-level security (RLS).

DATABASE_URL=postgresql://user:pass@localhost:5432/multitenant_db
JWT_SECRET=dev-secret-replace-in-production
PORT=3000
